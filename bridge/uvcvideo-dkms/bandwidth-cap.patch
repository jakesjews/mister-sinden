diff --color -ru /tmp/uvc-orig/uvc_video.c src/uvc_video.c
--- /tmp/uvc-orig/uvc_video.c	2026-10-01 04:25:50.528112864 -0400
+++ src/uvc_video.c	2026-10-01 04:25:50.551674169 -0400
@@ -231,6 +231,23 @@
 
 		ctrl->dwMaxPayloadTransferSize = bandwidth;
 	}
+
+	/*
+	 * mister-sinden: some cameras (the Sinden Lightgun's among them) ask for
+	 * the largest high-speed isochronous payload at every resolution, far
+	 * more than their MJPEG stream needs. Two of them then reserve most of
+	 * a USB 2.0 bus and starve everything else on it. Let the administrator
+	 * cap the payload size, which makes the driver pick a smaller alternate
+	 * setting (same idea as Batocera's bandwidth_cap patch).
+	 */
+	if (uvc_bandwidth_cap_param &&
+	    stream->intf->num_altsetting > 1 &&
+	    ctrl->dwMaxPayloadTransferSize > uvc_bandwidth_cap_param) {
+		dev_info(&stream->intf->dev,
+			 "bandwidth capped from %u to %u bytes per (micro)frame\n",
+			 ctrl->dwMaxPayloadTransferSize, uvc_bandwidth_cap_param);
+		ctrl->dwMaxPayloadTransferSize = uvc_bandwidth_cap_param;
+	}
 }
 
