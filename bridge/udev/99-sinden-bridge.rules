# A Sinden gun (VID 16c0, PIDs 0f01/0f02/0f38/0f39) was plugged in or removed: let
# sinden-hotplug.service decide whether the driver needs restarting (it does only when the set of
# attached guns really changed). PRODUCT is "16c0/f38/100" style and is present on remove events too.
ACTION=="add|remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="16c0/f01/*|16c0/f02/*|16c0/f38/*|16c0/f39/*", RUN+="/bin/systemctl --no-block start sinden-hotplug.service"
