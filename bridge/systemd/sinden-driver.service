[Unit]
Description=Sinden Lightgun driver (vendor LightgunMono under Mono)
After=multi-user.target

[Service]
Type=simple
WorkingDirectory=/opt/sinden
ExecStartPre=/opt/mister-sinden/bridge/hotplug/sinden-guns.sh record
ExecStart=/usr/bin/mono /opt/sinden/LightgunMono.exe
# The driver exits when no gun is attached ("E1"); keep retrying so a first gun is picked up.
# Later changes are handled by sinden-hotplug.service.
Restart=always
RestartSec=3
Nice=-10
StandardOutput=append:/var/log/sinden-driver.log
StandardError=append:/var/log/sinden-driver.log

[Install]
WantedBy=multi-user.target
