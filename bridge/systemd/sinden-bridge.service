[Unit]
Description=Sinden gun evdev -> USB HID gadget bridge
After=sinden-gadget.service
Requires=sinden-gadget.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mister-sinden/bridge/hid-bridge/hid_bridge.py --pump-offscreen-shot
# Drop --pump-offscreen-shot to get the pump back as a plain joystick button (10).
# Exits when the gun disappears; restart picks the gun up again.
Restart=always
RestartSec=2
Nice=-15

[Install]
WantedBy=multi-user.target
